# Credentials only. Copy to `.env.secrets`, which is gitignored and never committed:
#
#   cp .env.secrets.example .env.secrets
#
# Compose counterpart of `hopr-secret` (k8s/hopr-chart/templates/secret.yaml). Keeping
# credentials in their own file -- even when the local value is empty -- is the point:
# how you handle secrets locally is how you end up handling them in production.

# The local Compose Redis cluster starts without `--requirepass`, so this is empty for
# local development. A deployed Redis sets a real password here (and in the chart's
# `redis.password` value, which should come from your cluster's secret store, not values.yaml).
REDIS_PASSWORD=

# Plaintext API key the frontend's /api/shorten route presents to shortener-service.
# It belongs here rather than in .env because, unlike the digests the service stores,
# this value is replayable. Must be a key whose digest is in SHORTENER_API_KEY_HASHES;
# the local development key matching .env.example's digest is `hopr-local-dev-key`.
SHORTEN_API_KEY=hopr-local-dev-key
