# Base URL of the Hopr API gateway (nginx, see docker-compose.yml at repo root).
NEXT_PUBLIC_API_BASE_URL=http://hopr.localhost:80

# API key sent as X-API-Key on POST /shorten. NEXT_PUBLIC_ variables are inlined into the
# browser bundle, so this key is public by construction: it identifies the client for rate
# limiting and revocation, it does not authenticate a user. Matches the digest shipped in the
# repo root's .env.example.
NEXT_PUBLIC_API_KEY=hopr-local-dev-key
