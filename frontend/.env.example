# Server-only (no NEXT_PUBLIC_ prefix): base URL of the Hopr API gateway that the
# /api/shorten route proxies to (nginx, see docker-compose.yml at repo root).
SHORTENER_API_BASE_URL=http://hopr.localhost:80

# API key sent as X-API-Key on POST /shorten by src/app/api/shorten/route.ts. It is read
# server-side on purpose: a NEXT_PUBLIC_ variable is inlined into the browser bundle and
# readable by anyone who opens devtools, so it could not act as a credential. Matches the
# digest shipped in the repo root's .env.example.
SHORTEN_API_KEY=hopr-local-dev-key
