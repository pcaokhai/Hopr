# Credentials for the frontend container only. Copy to `.env.frontend.secrets`, which is
# gitignored and never committed:
#
#   cp .env.frontend.secrets.example .env.frontend.secrets
#
# Separate from `.env.secrets` on purpose: the frontend is the public-facing tier and has no
# business holding backend credentials. The chart does the same by handing its Deployment a
# single secretKeyRef (k8s/hopr-chart/templates/frontend.yaml).

# Plaintext API key the frontend's server-side /api/shorten route presents to
# shortener-service. Unlike the digests the service stores, this value is replayable, which
# is why it lives with the credentials. Must be a key whose digest is in
# SHORTENER_API_KEY_OWNERS; the local development key matching .env.example's first digest is below.
SHORTEN_API_KEY=hopr-local-dev-key
