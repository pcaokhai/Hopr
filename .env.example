# Non-secret Compose configuration. Copy to `.env` and adjust if your local ports differ:
#
#   cp .env.example .env
#
# This is the Compose counterpart of the chart's ConfigMap
# (k8s/hopr-chart/templates/configmap.yaml). Secrets do NOT belong here -- they go in
# `.env.secrets` (see `.env.secrets.example`), mirroring `hopr-secret` in the chart.

# --- ScyllaDB ---
SCYLLA_CONTACT_POINTS=scylla-node-1:9042,scylla-node-2:9042,scylla-node-3:9042
SCYLLA_PORT=9042
SCYLLA_KEYSPACE=hopr
SCYLLA_DATACENTER=datacenter1

# --- Redis cluster ---
REDIS_NODE_1=redis-node-1:6379
REDIS_NODE_2=redis-node-2:6379
REDIS_NODE_3=redis-node-3:6379
REDIS_NODE_4=redis-node-4:6379
REDIS_NODE_5=redis-node-5:6379
REDIS_NODE_6=redis-node-6:6379
REDIS_PORT=6379
REDIS_TIMEOUT=2000ms
SPRING_CACHE_TYPE=redis

# --- Services ---
SHORTENER_SERVER_PORT=8080
RESOLVER_SERVER_PORT=8083
KEYGEN_SERVER_PORT=8081
SHORTENER_DOMAIN=http://hopr.localhost/
