# Non-secret Compose configuration. Copy to `.env` and adjust if your local ports differ:
#
#   cp .env.example .env
#
# This is the Compose counterpart of the chart's ConfigMap
# (k8s/hopr-chart/templates/configmap.yaml). Secrets do NOT belong here -- they go in
# `.env.secrets` (see `.env.secrets.example`), mirroring `hopr-secret` in the chart.

# --- ScyllaDB ---
SCYLLA_CONTACT_POINTS=scylla-node-1:9042,scylla-node-2:9042,scylla-node-3:9042
SCYLLA_PORT=9042
SCYLLA_KEYSPACE=hopr
SCYLLA_DATACENTER=datacenter1

# --- Redis cluster ---
REDIS_NODE_1=redis-node-1:6379
REDIS_NODE_2=redis-node-2:6379
REDIS_NODE_3=redis-node-3:6379
REDIS_NODE_4=redis-node-4:6379
REDIS_NODE_5=redis-node-5:6379
REDIS_NODE_6=redis-node-6:6379
REDIS_PORT=6379
REDIS_TIMEOUT=2000ms
SPRING_CACHE_TYPE=redis

# --- Kafka ---
# Single-broker, KRaft-mode dev broker -- see docker-compose.yml's `kafka` service comment
# for why a full multi-broker cluster is overkill at this learning-project scale.
KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# --- Services ---
SHORTENER_SERVER_PORT=8080
RESOLVER_SERVER_PORT=8083
KEYGEN_SERVER_PORT=8081
CLICK_ANALYTICS_SERVER_PORT=8084
SHORTENER_DOMAIN=https://hopr.localhost/

# --- /v1/shorten API keys and their owners ---
# Comma-separated `<sha-256 digest>:<owner-id>` pairs: the API keys accepted on POST
# /v1/shorten and the /v1/links management endpoints, each mapped to the owner whose links it
# manages. Digests, not keys, which is why this belongs in non-secret config rather than
# .env.secrets: a digest cannot be replayed against the API. The plaintext key is what a client
# must keep secret. The value below is the digest of the local development key
# `hopr-local-dev-key` (owner `local-dev`):
#
#   curl -k -X POST https://hopr.localhost/v1/shorten -H 'X-API-Key: hopr-local-dev-key' ...
#   curl -k https://hopr.localhost/v1/links -H 'X-API-Key: hopr-local-dev-key'
#
# Add another `<digest>:<owner-id>` pair (comma separated) to see the per-owner scoping scope:
# a second owner's /v1/links listing does not contain the first owner's links.
#
# Links created before per-owner scoping existed are stamped with the owner id `legacy` at
# startup (see shortener-service's LegacyOwnerBackfill); configure a `<digest>:legacy` pair
# here if you need to manage them.
#
# Mint your own with:
#
#   KEY=$(openssl rand -hex 32); echo "key=$KEY"; printf %s "$KEY" | shasum -a 256
SHORTENER_API_KEY_OWNERS=6e324a82022ddfc1cfd82d12a1888affe6b14af3672a750ee2cd21fa1934ccea:local-dev
